# The real credentials file lives outside the repo, but a stray copy must never
# be committed. Anchored to the repo root so it cannot swallow source files such
# as src/lib/kit/credentials.ts.
/credentials
/*.credentials

# project-scoped lighter-agent-kit install (cloned by `npm run setup`)
.agents/skills/
.agents/.vendor/
.vendor/

