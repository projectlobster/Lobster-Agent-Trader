# ---------------------------------------------------------------------------
# Lobster Agent Trader — environment
# Copy to .env.local and fill in. Never commit the filled file.
# ---------------------------------------------------------------------------

# --- LLM (the "AI token" budget is spent here) ------------------------------
# Provider used by the decision agent: "openrouter" | "anthropic" | "openai".
# OpenRouter is the easiest way to start: many models are free, and it reports
# an authoritative per-call cost that the ledger records verbatim.
LIGHTER_TRADER_LLM_PROVIDER=openrouter
LIGHTER_TRADER_LLM_MODEL=inclusionai/ling-3.0-flash-sante:free
# reasoning budget: "off" | "low" | "medium" | "high". Reasoning models burn
# output tokens thinking before they answer, so "off" or "low" is usually right.
LIGHTER_TRADER_LLM_REASONING=low

LIGHTER_TRADER_OPENROUTER_API_KEY=
LIGHTER_TRADER_ANTHROPIC_API_KEY=
LIGHTER_TRADER_OPENAI_API_KEY=

# --- lighter-agent-kit ------------------------------------------------------
# Optional explicit path. Leave empty to auto-detect:
#   <repo>/.agents/skills/lighter-agent-kit -> ~/.agents/... -> ~/.claude/...
LIGHTER_AGENT_KIT_DIR=
# Python interpreter used to run the kit scripts
LIGHTER_TRADER_PYTHON=python3

# --- Lighter deployment (read by the kit) -----------------------------------
# Lighter mainnet / testnet / Robinhood Lighter. Keep this consistent with the
# credentials file at ~/.lighter/lighter-agent-kit/credentials.
LIGHTER_HOST=https://mainnet.zklighter.elliot.ai

# Credentials for private reads + live writes. Environment variables take
# precedence over ~/.lighter/lighter-agent-kit/credentials.
# LIGHTER_API_PRIVATE_KEY=
# LIGHTER_ACCOUNT_INDEX=
# LIGHTER_API_KEY_INDEX=

# --- Safety ------------------------------------------------------------------
# Live trading stays disabled unless this is exactly "1" AND the console
# switch is on AND the confirmation dialog is completed.
LIGHTER_ENABLE_LIVE=0

# --- Storage -----------------------------------------------------------------
# LIGHTER_TRADER_DB=./data/lighter-trader.db

# Access control. Unset means no authentication, which is only safe while the
# server stays on 127.0.0.1. If you bind a public interface, set this AND put a
# TLS-terminating reverse proxy in front — basic auth is cleartext.
# LIGHTER_TRADER_PASSWORD=
